<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvItemHomeLogs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="30dp"
    android:layout_marginStart="30dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/background"
    app:cardElevation="10dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/primary"
    app:cardCornerRadius="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:padding="16dp"
        android:background="#0DFFFFFF">

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_add_friend_notification"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvNotificationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/cairo_bold"
            android:text="طلب صداقة"
            android:textColor="@color/title"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/ivNotification"
            app:layout_constraintTop_toTopOf="@+id/ivNotification" />

        <TextView
            android:id="@+id/tvNotificationDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:text="Eyad Hisham ارسل طلب صداقة"
            android:textColor="@color/description"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@+id/tvNotificationTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvNotificationTitle" />


        <TextView
            android:id="@+id/tvNotificationDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:text="منذ 5 دقائق"
            android:textColor="@color/primary"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDeleteNotification"
            android:visibility="gone"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_delete_notification"
            android:fontFamily="@font/cairo_semibold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:drawableStart="@drawable/ic_delete_small"
            android:drawablePadding="8dp"
            android:text="@string/delete"
            android:textColor="@color/bad_sugar_reading"
            android:textSize="8sp"
            app:layout_constraintStart_toStartOf="@+id/tvLastMessage"
            app:layout_constraintTop_toBottomOf="@+id/tvLastMessage" />

        <TextView
            android:id="@+id/tvAcceptFriend"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_accept_notification"
            android:fontFamily="@font/cairo_semibold"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:drawableStart="@drawable/ic_accept_friend_notification"
            android:drawablePadding="8dp"
            android:text="@string/accept"
            android:textColor="@color/primary"
            android:textSize="8sp"
            app:layout_constraintStart_toStartOf="@+id/tvLastMessage"
            app:layout_constraintTop_toBottomOf="@+id/tvLastMessage" />

        <TextView
            android:id="@+id/tvRejectFriend"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_delete_notification"
            android:fontFamily="@font/cairo_semibold"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:drawableStart="@drawable/ic_reject_friend"
            android:drawablePadding="8dp"
            android:text="@string/reject"
            android:textColor="@color/bad_sugar_reading"
            android:textSize="8sp"
            app:layout_constraintStart_toEndOf="@+id/tvAcceptFriend"
            app:layout_constraintTop_toBottomOf="@+id/tvLastMessage" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

