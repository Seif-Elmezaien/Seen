<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/flCommentAvatarStroke"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/avatar_border_type2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:id="@+id/ivCommentProfile"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/profile2" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvUserCommentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/cairo_bold"
            android:text="منتصر إسماعيل"
            android:textColor="@color/title"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/flCommentAvatarStroke"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvCommentTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/post_time"
            android:textColor="@color/description"
            app:layout_constraintStart_toStartOf="@+id/tvUserCommentName"
            app:layout_constraintTop_toBottomOf="@+id/tvUserCommentName" />

        <TextView
            android:id="@+id/tvCommentText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/cairo"
            android:text="خطوة بسيطة بس فرقها كبير  👏"
            android:textColor="@color/description"
            android:textSize="14sp"
            android:textStyle="normal"
            app:layout_constraintEnd_toStartOf="@+id/editComment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/flCommentAvatarStroke" />

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:background="#80D9D9D9"
            app:layout_constraintTop_toBottomOf="@+id/tvCommentText"
            tools:layout_editor_absoluteX="16dp" />

        <ImageView
            android:id="@+id/iv_comments_like"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/heart_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_comments_likes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="120"
            android:textColor="@color/description"
            android:textSize="12dp"
            android:textStyle="normal"
            app:layout_constraintEnd_toEndOf="@+id/iv_comments_like"
            app:layout_constraintStart_toStartOf="@+id/iv_comments_like"
            app:layout_constraintTop_toBottomOf="@+id/iv_comments_like" />

        <ImageView
            android:id="@+id/deleteComment"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="15dp"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/editComment"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_edit_comment"
            app:layout_constraintBottom_toBottomOf="@+id/deleteComment"
            app:layout_constraintEnd_toStartOf="@+id/deleteComment"
            app:layout_constraintTop_toTopOf="@+id/deleteComment"
            android:layout_marginEnd="15dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>