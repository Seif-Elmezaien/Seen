<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.community.fragment.PostDetailsFragment">


    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/commentBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            android:paddingHorizontal="32dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:id="@+id/arrowBg"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_post_cardview"
                app:layout_constraintBottom_toTopOf="@+id/materialCardView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="10dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:rotation="180"
                    android:src="@drawable/ic_back_arrow" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                app:cardBackgroundColor="@color/background"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/arrowBg">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_post_cardview"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/flAvatarStroke"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/avatar_border_type2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivProfile"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/profile" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/ivPostImage"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="12dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/iv_post1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/flAvatarStroke" />

                    <TextView
                        android:id="@+id/tvUserPostName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:fontFamily="@font/cairo_bold"
                        android:text="منتصر إسماعيل"
                        android:textColor="@color/title"
                        android:textSize="14sp"
                        app:layout_constraintStart_toEndOf="@+id/flAvatarStroke"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPostTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/post_time"
                        android:textColor="@color/description"
                        app:layout_constraintStart_toStartOf="@+id/tvUserPostName"
                        app:layout_constraintTop_toBottomOf="@+id/tvUserPostName" />

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_diabetes_type1"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="@string/category_type1_lada"
                        android:textColor="@color/Type1_lada_red"
                        android:textSize="10sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPostTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:fontFamily="@font/cairo_bold"
                        android:text="يوم صعب مع ارتفاع السكر"
                        android:textColor="@color/card_title"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivPostImage" />

                    <TextView
                        android:id="@+id/tvPostContent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="@font/cairo"
                        android:text="النهارده السكر كان عالي أكتر من المعتاد، وحسيت بتعب وصداع.حاولت أظبط أكلي وأشرب مية وأمشي شوية، وإن شاء الله الأرقام تتحسن.
المهم إني مكمل ومش مستسلم."
                        android:textColor="@color/card_title"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPostTitle" />

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="16dp"
                        android:background="#80D9D9D9"
                        app:layout_constraintTop_toBottomOf="@+id/tvPostContent" />

                    <ImageView
                        android:id="@+id/ivLike"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/heart_selector"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view" />

                    <TextView
                        android:id="@+id/tv_likes_count_dt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="120"
                        android:textColor="@color/description"
                        app:layout_constraintBottom_toBottomOf="@+id/ivLike"
                        app:layout_constraintStart_toEndOf="@+id/ivLike"
                        app:layout_constraintTop_toTopOf="@+id/ivLike" />

                    <ImageView
                        android:id="@+id/imageView3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_post_comments"
                        app:layout_constraintStart_toEndOf="@+id/tv_likes_count_dt"
                        app:layout_constraintTop_toTopOf="@+id/tv_likes_count_dt" />

                    <TextView
                        android:id="@+id/tv_comments_count_dt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="80"
                        android:textColor="@color/description"
                        app:layout_constraintStart_toEndOf="@+id/imageView3"
                        app:layout_constraintTop_toTopOf="@+id/imageView3" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_community_comment"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/materialCardView" />

            <ProgressBar
                android:id="@+id/paginationProgressBar"
                style="?attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvComments" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Fixed comment bar at the bottom -->
    <LinearLayout
        android:id="@+id/commentBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_post_cardview"
        android:paddingHorizontal="12dp"
        android:paddingVertical="20dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etComment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/make_comment"
            android:layoutDirection="rtl"
            android:textAlignment="viewEnd"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="1"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:textColorHint="@color/title" />

        <ImageButton
            android:id="@+id/btnSendComment"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_send_button"
            android:background="@android:color/transparent"
            android:contentDescription="Send comment"
            android:padding="10dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>