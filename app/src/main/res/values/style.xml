<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="progressDotInactive">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/ic_auth_dot_inactive</item>
    </style>

    <style name="progressDotActive">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/ic_auth_dot_active</item>
    </style>

    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="ChipTextAppearance" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:fontFamily">@font/cairo_bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CategoryChip" parent="Widget.MaterialComponents.Chip.Choice">

        <item name="android:textAppearance">@style/ChipTextAppearance</item>

        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="chipIconVisible">true</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="chipMinHeight">42dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="SearchCategory" parent="Widget.MaterialComponents.Chip.Choice">

        <item name="android:textAppearance">@style/ChipTextAppearance</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipCornerRadius">30dp</item>
        <item name="chipIconVisible">true</item>
        <item name="chipStartPadding">16dp</item>
        <item name="chipEndPadding">16dp</item>
        <item name="chipMinHeight">42dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="GraphCardStyle">
        <item name="cardElevation">10dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

</resources>