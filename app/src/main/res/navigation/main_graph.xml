<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/homeEntryFragment">
    <fragment
        android:id="@+id/homeEntryFragment"
        android:name="com.example.seen.ui.home.fragment.HomeEntryFragment"
        android:label="fragment_home_entry"
        tools:layout="@layout/fragment_home_entry" >
        <action
            android:id="@+id/action_homeEntryFragment_to_onboardingContainerFragment"
            app:destination="@id/onboardingContainerFragment" />
        <action
            android:id="@+id/action_homeEntryFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeEntryFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/onboardingContainerFragment"
        android:name="com.example.seen.ui.home.fragment.OnboardingContainerFragment"
        android:label="fragment_onboarding_container"
        tools:layout="@layout/fragment_onboarding_container" >
        <action
            android:id="@+id/action_onboardingContainerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingContainerFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.seen.ui.home.fragment.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_reminderFragment"
            app:destination="@id/reminderFragment" />
    </fragment>
    <fragment
        android:id="@+id/communityFragment"
        android:name="com.example.seen.ui.community.fragment.CommunityFragment"
        android:label="fragment_community"
        tools:layout="@layout/fragment_community" >
        <action
            android:id="@+id/action_communityFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/moreFragment"
        android:name="com.example.seen.ui.more.fragment.MoreFragment"
        android:label="fragment_more"
        tools:layout="@layout/fragment_more" />
    <fragment
        android:id="@+id/reminderFragment"
        android:name="com.example.seen.ui.reminder.fragment.ReminderFragment"
        android:label="fragment_reminder"
        tools:layout="@layout/fragment_reminder" >
        <action
            android:id="@+id/action_reminderFragment_to_addReminderFragment"
            app:destination="@id/addReminderFragment" />
    </fragment>
    <fragment
        android:id="@+id/reportFragment"
        android:name="com.example.seen.ui.report.fragment.ReportFragment"
        android:label="fragment_report"
        tools:layout="@layout/fragment_report" />
    <fragment
        android:id="@+id/addLogsFragment"
        android:name="com.example.seen.ui.home.fragment.AddLogsFragment"
        android:label="fragment_add_logs"
        tools:layout="@layout/fragment_add_logs" />
    <fragment
        android:id="@+id/addReminderFragment"
        android:name="com.example.seen.ui.reminder.fragment.AddReminderFragment"
        android:label="fragment_add_reminder"
        tools:layout="@layout/fragment_add_reminder" />
    <fragment
        android:id="@+id/postDetailsFragment"
        android:name="com.example.seen.ui.community.fragment.PostDetailsFragment"
        android:label="fragment_post_details"
        tools:layout="@layout/fragment_post_details" />
</navigation>