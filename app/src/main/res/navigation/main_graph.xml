<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/homeEntryFragment">
    <fragment
        android:id="@+id/homeEntryFragment"
        android:name="com.example.seen.ui.home.fragment.HomeEntryFragment"
        android:label="fragment_home_entry"
        tools:layout="@layout/fragment_home_entry" >
        <action
            android:id="@+id/action_homeEntryFragment_to_onboardingContainerFragment"
            app:destination="@id/onboardingContainerFragment" />
        <action
            android:id="@+id/action_homeEntryFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeEntryFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/onboardingContainerFragment"
        android:name="com.example.seen.ui.home.fragment.OnboardingContainerFragment"
        android:label="fragment_onboarding_container"
        tools:layout="@layout/fragment_onboarding_container" >
        <action
            android:id="@+id/action_onboardingContainerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingContainerFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.seen.ui.home.fragment.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_reminderFragment"
            app:destination="@id/reminderFragment" />
        <action
            android:id="@+id/action_homeFragment_to_logDetailFragment"
            app:destination="@id/logDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_chatbotFragment"
            app:destination="@id/chatbotFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_notificationFragment"
            app:destination="@id/notificationFragment" />
    </fragment>
    <fragment
        android:id="@+id/communityFragment"
        android:name="com.example.seen.ui.community.fragment.CommunityFragment"
        android:label="fragment_community"
        tools:layout="@layout/fragment_community" >
        <action
            android:id="@+id/action_communityFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment" />
        <action
            android:id="@+id/action_communityFragment_to_communitySearchFragment"
            app:destination="@id/communitySearchFragment" />
        <action
            android:id="@+id/action_communityFragment_to_addPostFragment"
            app:destination="@id/addPostFragment" />
        <action
            android:id="@+id/action_communityFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/moreFragment"
        android:name="com.example.seen.ui.more.fragment.MoreFragment"
        android:label="fragment_more"
        tools:layout="@layout/fragment_account_and_settings" />
    <fragment
        android:id="@+id/reminderFragment"
        android:name="com.example.seen.ui.reminder.fragment.ReminderFragment"
        android:label="fragment_reminder"
        tools:layout="@layout/fragment_reminder" >
        <action
            android:id="@+id/action_reminderFragment_to_addReminderFragment"
            app:destination="@id/addReminderFragment" />
    </fragment>
    <fragment
        android:id="@+id/reportFragment"
        android:name="com.example.seen.ui.report.fragment.ReportFragment"
        android:label="fragment_report"
        tools:layout="@layout/fragment_report" >
        <action
            android:id="@+id/action_reportFragment_to_logDetailFragment"
            app:destination="@id/logDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/addLogsFragment"
        android:name="com.example.seen.ui.home.fragment.AddLogsFragment"
        android:label="fragment_add_logs"
        tools:layout="@layout/fragment_add_logs" />
    <fragment
        android:id="@+id/addReminderFragment"
        android:name="com.example.seen.ui.reminder.fragment.AddReminderFragment"
        android:label="fragment_add_reminder"
        tools:layout="@layout/fragment_add_reminder" />
    <fragment
        android:id="@+id/postDetailsFragment"
        android:name="com.example.seen.ui.community.fragment.PostDetailsFragment"
        android:label="fragment_post_details"
        tools:layout="@layout/fragment_post_details" >
        <argument
            android:name="post"
            app:argType="com.example.seen.domain.model.community.Data" />
        <action
            android:id="@+id/action_postDetailsFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/communitySearchFragment"
        android:name="com.example.seen.ui.community.fragment.CommunitySearchFragment"
        android:label="fragment_community_search"
        tools:layout="@layout/fragment_community_search" >
        <action
            android:id="@+id/action_communitySearchFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment" />
        <action
            android:id="@+id/action_communitySearchFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/logDetailFragment"
        android:name="com.example.seen.ui.home.fragment.LogDetailFragment"
        android:label="LogDetailFragment" >
        <argument
            android:name="FullLog"
            app:argType="com.example.seen.domain.model.entites.FullLog" />
        <action
            android:id="@+id/action_logDetailFragment_to_editLogsFragment"
            app:destination="@id/editLogsFragment" />
    </fragment>
    <fragment
        android:id="@+id/editLogsFragment"
        android:name="com.example.seen.ui.home.fragment.EditLogsFragment"
        android:label="EditLogsFragment" >
        <argument
            android:name="FullLog"
            app:argType="com.example.seen.domain.model.entites.FullLog" />
    </fragment>
    <fragment
        android:id="@+id/addPostFragment"
        android:name="com.example.seen.ui.community.fragment.AddPostFragment"
        android:label="AddPostFragment" />
    <fragment
        android:id="@+id/chatbotFragment"
        android:name="com.example.seen.ui.home.fragment.ChatbotFragment"
        android:label="ChatbotFragment" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.seen.ui.community.fragment.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <argument
            android:name="user_id"
            app:argType="integer" />
        <action
            android:id="@+id/action_profileFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.example.seen.ui.notification.fragment.NotificationFragment"
        android:label="NotificationFragment" >
        <action
            android:id="@+id/action_notificationFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_notificationFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment" />
    </fragment>
</navigation>